/* =====================================================================
   Hoja de estilos de EnerGest
   Ruta: resources/styles/theme.qss

   QSS es el "CSS" de Qt. Los selectores con # apuntan al objectName
   que se asigna en el código, ej. setObjectName("botonPrimario").

   Se definen colores explícitos para todo: así la aplicación se ve igual
   aunque Windows esté en modo oscuro.
   ===================================================================== */

* {
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 10pt;
}

QMainWindow, QWidget {
    background-color: #F5F7FA;
    color: #1F2933;
}

/* --- Menú lateral ---------------------------------------------------- */
#menuLateral {
    background-color: #1F3A5F;
}
#menuLateral QLabel {
    background-color: transparent;
}
#logo {
    color: #FFFFFF;
    font-size: 30pt;
    font-weight: bold;
}
#subtituloLogo {
    color: #A9C4E4;
    font-size: 10pt;
}
#botonMenu {
    background-color: transparent;
    color: #E3ECF7;
    border: none;
    border-radius: 6px;
    padding: 10px 14px;
    text-align: left;
}
#botonMenu:hover {
    background-color: #2B4D78;
}
#botonMenu:checked {
    background-color: #2E75B6;
    color: #FFFFFF;
    font-weight: bold;
}
#botonMenu:disabled {
    color: #6F86A3;
}

/* --- Títulos y textos ------------------------------------------------ */
#tituloVista {
    font-size: 16pt;
    font-weight: bold;
    color: #1F3A5F;
}
#tituloPanel {
    font-size: 11pt;
    font-weight: bold;
    color: #1F3A5F;
    background-color: transparent;
}
#textoSecundario {
    color: #6C757D;
    background-color: transparent;
}
#proximoNumero {
    color: #1F3A5F;
    background-color: transparent;
    padding: 6px 0;
}

/* --- Botones ---------------------------------------------------------- */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #C4CDD5;
    border-radius: 5px;
    padding: 6px 14px;
}
QPushButton:hover {
    background-color: #EEF3F8;
}
#botonPrimario {
    background-color: #2E75B6;
    color: #FFFFFF;
    border: none;
    font-weight: bold;
    padding: 8px 18px;
}
#botonPrimario:hover {
    background-color: #255F94;
}

/* --- Campos de entrada ------------------------------------------------ */
QLineEdit, QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #C4CDD5;
    border-radius: 5px;
    padding: 6px 8px;
    min-height: 20px;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QLineEdit:focus, QComboBox:focus {
    border: 1px solid #2E75B6;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    selection-background-color: #2E75B6;
    selection-color: #FFFFFF;
}

/* --- Tabla ------------------------------------------------------------ */
QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    border: 1px solid #D5DCE3;
    border-radius: 6px;
    gridline-color: #E4E9EE;
    selection-background-color: #D6E6F5;
    selection-color: #1F2933;
}
QHeaderView::section {
    background-color: #E9EEF4;
    color: #1F3A5F;
    font-weight: bold;
    border: none;
    border-right: 1px solid #D5DCE3;
    border-bottom: 1px solid #D5DCE3;
    padding: 8px 6px;
}

/* --- Panel de números libres ----------------------------------------- */
#panelNumeros {
    background-color: #FFFFFF;
    border: 1px solid #D5DCE3;
    border-radius: 8px;
}
#panelNumeros QListWidget {
    background-color: #F8FAFC;
    border: 1px solid #E4E9EE;
    border-radius: 5px;
}
#panelNumeros QListWidget::item {
    padding: 6px 8px;
}
#panelNumeros QListWidget::item:hover {
    background-color: #EEF3F8;
}

/* --- Barra de estado y diálogos -------------------------------------- */
QStatusBar {
    background-color: #E9EEF4;
}
QMessageBox, QDialog {
    background-color: #FFFFFF;
}
QToolTip {
    background-color: #1F3A5F;
    color: #FFFFFF;
    border: none;
    padding: 4px;
}

/* =====================================================================
   Formularios y diálogos (Entrega D)
   ===================================================================== */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #D5DCE3;
    border-radius: 6px;
    margin-top: 14px;
    padding: 12px 10px 8px 10px;
    font-weight: bold;
    color: #1F3A5F;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}
QGroupBox QLabel, QGroupBox QCheckBox {
    background-color: transparent;
    font-weight: normal;
    color: #1F2933;
}
QDialog QLabel {
    background-color: transparent;
}
#envolturaCampo {
    background-color: transparent;
}
QSpinBox, QDoubleSpinBox, QDateEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #C4CDD5;
    border-radius: 5px;
    padding: 5px 8px;
}
QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #2E75B6;
}
QSpinBox:disabled, QDoubleSpinBox:disabled, QDateEdit:disabled {
    color: #9AA5B1;
    background-color: #F1F3F5;
}

/* Campo con error: lo activa el código con setProperty("error", True) */
*[error="true"] {
    border: 1px solid #C0392B;
    background-color: #FDF2F1;
}
#errorCampo {
    color: #C0392B;
    font-size: 9pt;
    font-weight: normal;
    background-color: transparent;
}
#mensajeError {
    color: #C0392B;
    background-color: #FDF2F1;
    border: 1px solid #F1C4BF;
    border-radius: 5px;
    padding: 8px;
}
#avisoInformativo {
    color: #1F3A5F;
    background-color: #EAF2FB;
    border: 1px solid #C5DCF2;
    border-radius: 5px;
    padding: 8px;
}
#datoSistema {
    color: #1F3A5F;
    font-weight: bold;
    background-color: transparent;
}

/* Pestañas del historial */
QTabWidget::pane {
    border: 1px solid #D5DCE3;
    border-radius: 6px;
    background-color: #FFFFFF;
}
QTabBar::tab {
    background-color: #E9EEF4;
    color: #1F3A5F;
    padding: 8px 16px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #2E75B6;
    color: #FFFFFF;
    font-weight: bold;
}
